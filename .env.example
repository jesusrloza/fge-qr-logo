# ===========================================
# FGE QR Logo - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# JWT Secret for user authentication (REQUIRED)
# Generate a secure random string, e.g.: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-replace-with-random-string

# Base URL path for deployment (OPTIONAL)
# Use this when deploying to a subpath like /fge-qr-logo/
# Must start and end with / (e.g., /fge-qr-logo/)
# Leave empty or "/" for root deployment
# VITE_BASE_URL=/
VITE_BASE_URL=/fge-qr-logo/

# Enable authentication modal (OPTIONAL)
# Set to "true" to require CURP authentication before using the app
# If not set or false, users can use the app without authentication
VITE_ENABLE_AUTH=false

# Server Port (OPTIONAL, defaults to 4173 in dev, 3000 in Docker production)
PORT=4173

# Node Environment
NODE_ENV=development
