# ===========================================
# FGE QR Logo - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# JWT Secret for user authentication (REQUIRED)
# Generate a secure random string, e.g.: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-replace-with-random-string

# Bit.ly Access Token (OPTIONAL)
# Required only if you want to use Bit.ly as a URL shortener service
# Get your token at: https://app.bitly.com/settings/api/
BITLY_ACCESS_TOKEN=

# Legacy Vite-exposed Bitly token (kept for backwards compatibility)
VITE_BITLY_ACCESS_TOKEN=

# Server Port (OPTIONAL, defaults to 4173 in dev, 3000 in Docker production)
PORT=4173

# Node Environment
NODE_ENV=development
